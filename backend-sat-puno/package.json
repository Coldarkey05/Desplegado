{
  "name": "backend-sat-puno",
  "version": "5.0.0",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "start:dev": "tsc-watch --onSuccess \"node dist/src/main.js\"",
    "prisma:generate": "prisma generate",
    "db:seed": "node --import tsx prisma/seed.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 test/integration/*.test.ts",
    "db:check": "node --import tsx scripts/check-db.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/platform-express": "11.2.6",
    "@nestjs/platform-socket.io": "11.2.6",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/websockets": "11.2.6",
    "@prisma/client": "6.19.0",
    "bcryptjs": "3.0.2",
    "dotenv": "16.6.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.18.6",
    "prisma": "6.19.0",
    "socket.io-client": "4.8.1",
    "tsc-watch": "7.2.0",
    "tsx": "4.20.5",
    "typescript": "5.9.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "effect": "3.20.0"
  }
}
